<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Markwardt.AutoRemote.Client.CloneWorkspaceView"
             x:CompileBindings="False">
  <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto,Auto" Margin="16">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
      <TextBlock Grid.Column="0" Text="Clone workspace" Classes="serif" FontSize="26" VerticalAlignment="Center" />
      <Button Grid.Column="1" Content="Cancel" Command="{Binding CancelCommand}" Classes="flat" />
    </Grid>
    <TextBlock Grid.Row="1" Text="The server clones the repository into a new folder inside the folder you pick, and a workspace is created in it." Classes="muted" TextWrapping="Wrap" Margin="0,0,0,12" />

    <TextBox Grid.Row="2" Text="{Binding Url}" PlaceholderText="Repository URL" Margin="0,0,0,8" />
    <TextBox Grid.Row="3" Text="{Binding Name}" PlaceholderText="Folder name (optional, defaults to the repository name)" Margin="0,0,0,12" />

    <Grid Grid.Row="4" DataContext="{Binding Browser}" ColumnDefinitions="Auto,*" Margin="0,0,0,8">
      <Button Grid.Column="0" Content="↑ Up" Command="{Binding UpCommand}" />
      <TextBlock Grid.Column="1" Text="{Binding CurrentPath, FallbackValue='Computer'}" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="PrefixCharacterEllipsis" />
    </Grid>

    <Border Grid.Row="5" Background="{DynamicResource Surface}" CornerRadius="4" Padding="6" DataContext="{Binding Browser}">
      <ListBox ItemsSource="{Binding Folders}" SelectedItem="{Binding Selected}" Background="Transparent">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="1" Text="›" Classes="muted" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <StackPanel Grid.Row="6" DataContext="{Binding Browser}" Spacing="8" Margin="0,12,0,0">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBox Grid.Column="0" Text="{Binding NewFolderName}" PlaceholderText="New folder name" />
        <Button Grid.Column="1" Content="Create" Command="{Binding CreateFolderCommand}" />
      </Grid>
      <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" Classes="error" />
    </StackPanel>

    <StackPanel Grid.Row="7" Spacing="8" Margin="0,12,0,0">
      <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" Classes="error" />
      <TextBlock Text="Cloning, this can take a while…" IsVisible="{Binding IsBusy}" Classes="muted" />
      <Button Content="Clone into this folder" Command="{Binding CloneCommand}" Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
    </StackPanel>
  </Grid>
</UserControl>
