<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Markwardt.AutoRemote.Client"
             x:Class="Markwardt.AutoRemote.Client.NewWorkspaceView"
             x:CompileBindings="False">
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" Margin="16">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
      <TextBlock Grid.Column="0" Text="New workspace" Classes="serif" FontSize="26" VerticalAlignment="Center" />
      <local:TouchButton Grid.Column="1" Content="Cancel" Command="{Binding CancelCommand}" Classes="flat" />
    </Grid>
    <StackPanel Grid.Row="1" Spacing="12" Margin="0,0,0,12">
      <local:ProviderPickerView DataContext="{Binding Provider}" />
      <TextBlock Text="Group" Classes="muted" />
      <ComboBox ItemsSource="{Binding Group.Choices}" SelectedItem="{Binding Group.Selected}" HorizontalAlignment="Stretch">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Name}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
    </StackPanel>

    <Grid Grid.Row="2" DataContext="{Binding Browser}" ColumnDefinitions="Auto,*" Margin="0,0,0,8">
      <local:TouchButton Grid.Column="0" Content="↑ Up" Command="{Binding UpCommand}" />
      <TextBlock Grid.Column="1" Text="{Binding CurrentPath, FallbackValue='Computer'}" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="PrefixCharacterEllipsis" />
    </Grid>

    <Border Grid.Row="3" Background="{DynamicResource Surface}" CornerRadius="4" Padding="6" DataContext="{Binding Browser}">
      <ListBox ItemsSource="{Binding Folders}" SelectedItem="{Binding Selected}" Background="Transparent">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="1" Text="›" Classes="muted" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <StackPanel Grid.Row="4" DataContext="{Binding Browser}" Spacing="8" Margin="0,12,0,0">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBox Grid.Column="0" Text="{Binding NewFolderName}" PlaceholderText="New folder name" />
        <local:TouchButton Grid.Column="1" Content="Create" Command="{Binding CreateFolderCommand}" />
      </Grid>
      <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" Classes="error" />
    </StackPanel>

    <StackPanel Grid.Row="5" Spacing="8" Margin="0,12,0,0">
      <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" Classes="error" />
      <local:TouchButton Content="Start Workspace in This Folder" Command="{Binding StartCommand}" Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
    </StackPanel>
  </Grid>
</UserControl>
